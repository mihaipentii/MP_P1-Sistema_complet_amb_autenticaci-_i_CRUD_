<!DOCTYPE html>
<html lang="es">
<head><meta charset="UTF-8"><title>Reservas</title><link rel="stylesheet" href="/styles.css"></head>
<body>
  <h1>Sistema de reservas</h1>
  <% if (user) { %>
    <p>Hola, <%= user.username %>.</p>
    <a href="/protected">Zona privada</a> · <a href="/profile">Perfil</a>
    <form action="/logout" method="POST"><button>Cerrar sesión</button></form>
  <% } else { %>
    <a href="/login">Iniciar sesión / Registrarse</a>
  <% } %>
</body>
</html>