<!DOCTYPE html>
<html lang="es">
<head><meta charset="UTF-8"><title>Acceso</title><link rel="stylesheet" href="/styles.css"></head>
<body>
  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <h2>Iniciar sesión</h2>
  <form action="/login" method="POST">
    <input name="username" placeholder="Usuario" required>
    <input name="password" type="password" placeholder="Contraseña" required>
    <button>Entrar</button>
  </form>

  <h2>Registrarse</h2>
  <form action="/register" method="POST">
    <input name="username" placeholder="Usuario" required minlength="3">
    <input name="password" type="password" placeholder="Contraseña (mín. 6)" required minlength="6">
    <button>Crear cuenta</button>
  </form>
</body>
</html>